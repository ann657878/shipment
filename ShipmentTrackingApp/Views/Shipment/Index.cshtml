@using ShipmentTrackingApp.Models.Enums
@model IEnumerable<ShipmentTrackingApp.Models.Shipment>
@{ ViewData["Title"] = "Shipments"; }

<h2>Shipment Tracking</h2>
<form method="get" class="row g-3 mb-4 mt-2">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Search ID or Customer..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ShipmentStatus>()">
            <option value="">-- All Statuses --</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<ShipmentType>()">
            <option value="">-- All Types --</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th> <th>Customer</th> <th>Origin -> Dest</th> <th>Type</th> <th>Status</th> <th>Exp. Date</th> <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ShipmentId</td> 
                    <td>@item.CustomerName</td> 
                    <td>@item.Origin -> @item.Destination</td> 
                    <td>@item.Type</td>
                    <td>
                        <span class="badge @(item.Status == ShipmentStatus.Delivered ? "bg-success" : item.Status == ShipmentStatus.Delayed ? "bg-danger" : "bg-warning text-dark")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.ExpectedDeliveryDate.ToShortDateString()</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
